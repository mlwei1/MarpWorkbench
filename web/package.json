    "@codemirror/view": "^6.36.8",
    "@marp-team/marp-core": "4.4.0",
    "codemirror": "^6.0.1",
    "html-to-image": "^1.11.13",
    "mermaid": "12.2.0",
    "pptxgenjs": "4.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.6"
