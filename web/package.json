{
  "name": "marp-workbench-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MarpWorkbench 前端（Vue 3 + Vite + CodeMirror 6 + marp-core 浏览器渲染）",
  "scripts": {
    "dev": "vite",
    "dev:real": "vite --mode real",
